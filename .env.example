# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.

# Resend API key — required for the contact + early-access forms to send mail.
# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides. The "from" domain MUST be verified in Resend
# (verify auresta.com.au there). Defaults are used if these are unset.
CONTACT_FROM_EMAIL="Auresta Website <noreply@auresta.com.au>"
CONTACT_TO_EMAIL="team@auresta.com.au"
